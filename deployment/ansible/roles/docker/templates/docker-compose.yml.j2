# Caps docker logs (backend prod.log goes to stderr), rotated by docker itself.
x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "5"

services:
  mariadb:
    image: mariadb:11.4
    user: "1000:1000"
    restart: unless-stopped
    logging: *logging
    environment:
      # runs mariadb-upgrade on start when the data dir comes from an older version
      MARIADB_AUTO_UPGRADE: "1"
      MYSQL_ROOT_PASSWORD: "$MYSQL_ROOT_PASSWORD"
      MYSQL_DATABASE: "$MYSQL_DATABASE"
      MYSQL_USER: "$MYSQL_USER"
      MYSQL_PASSWORD: "$MYSQL_PASSWORD"
    volumes:
      - ./mariadb/db:/var/lib/mysql
      - ./mariadb/conf/my.cnf:/etc/mysql/conf.d/my.cnf
      - ./mariadb/log:/var/log/mysql

  dw:
    build: dw
    command: ./main
    restart: unless-stopped
    logging: *logging
    volumes:
      - ../dw:/usr/src/app
    depends_on:
      - mariadb

  backend:
    build:
      context: backend
      target: prod
      pull: true
    restart: unless-stopped
    logging: *logging
    ports:
      - "{{ back_proxy_port }}:80"
    volumes:
      - ../backend:/var/www/html
      - ./backend/sites-enabled:/etc/apache2/sites-enabled
      - ./backend/conf.d/php.ini:/usr/local/etc/php/conf.d/php.ini
    depends_on:
      - mariadb

