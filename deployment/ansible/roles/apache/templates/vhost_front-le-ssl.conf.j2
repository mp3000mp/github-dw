<IfModule mod_ssl.c>
<VirtualHost *:443>
	ServerName {{ frontend_server_name }}
	DocumentRoot "{{ app_directory }}/frontend/dist"

	# Maintenance mode: when {{ app_directory }}/frontend/maintenance.on exists,
	# every non-asset request gets a 503 served from maintenance.html.
	RewriteEngine On
	RewriteCond {{ app_directory }}/frontend/maintenance.on -f
	RewriteCond %{REQUEST_URI} !=/maintenance.html
	RewriteCond %{REQUEST_URI} !\.(css|js|png|jpe?g|gif|svg|ico|webp|woff2?|ttf)$
	RewriteRule .* - [R=503,L]
	ErrorDocument 503 /maintenance.html

	<Directory {{ app_directory }}/frontend/dist/>
		Options FollowSymLinks MultiViews
		AllowOverride all
		Require all granted
		RewriteEngine on
		RewriteBase /
		RewriteRule ^index\.html$ - [L]
		RewriteCond %{REQUEST_FILENAME} !-f
		RewriteCond %{REQUEST_FILENAME} !-d
		RewriteRule . /index.html [L]
	</Directory>

	ErrorLog "{{ app_directory }}/frontend/log/apache_error.log"
	CustomLog "{{ app_directory }}/frontend/log/apache_access.log" combined

	SSLCertificateFile /etc/letsencrypt/live/{{ frontend_server_name }}/fullchain.pem
	SSLCertificateKeyFile /etc/letsencrypt/live/{{ frontend_server_name }}/privkey.pem
	Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
</IfModule>
